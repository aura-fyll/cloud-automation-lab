# cloud-automation-lab — Environment Configuration Template
#
# Copy this file to .env and fill in the values for local testing.
# NEVER commit the actual .env file to Git.
#
# For production use, set these as GitHub Secrets in your repository settings.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your values
#   python src/main.py --task authed_api

# === Task-Specific Configuration ===

# Authenticated API template task
# Replace with your actual API endpoint and token
SERVICE_API_KEY=
SERVICE_BASE_URL=https://api.example.com/v1
SERVICE_USERNAME=
SERVICE_PASSWORD=

# File processing task
# (No additional configuration needed — uses public data)

# Browser automation tasks (optional)
# BROWSER_HEADLESS=true
# SCREENSHOT_DIR=./screenshots

# === Core Configuration ===

# Logging level (DEBUG, INFO, WARNING, ERROR)
# AUTOMATION_LOG_LEVEL=INFO